# ─────────────────────────────────────────────────────
# Bruh Protocol — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# ─────────────────────────────────────────────────────

# Deployer private key (hex, with or without 0x prefix)
PRIVATE_KEY=0x...

# Arc Testnet RPC
ARC_RPC_URL=https://rpc.arc.io

# Arc Testnet block explorer (for --verify)
ARC_EXPLORER_URL=https://testnet.arcscan.app

# USDC on Arc Testnet (get from Circle docs / faucet)
USDC_ADDRESS=0x...

# Oracle agent wallet address (agent holds this key)
ORACLE_ADDRESS=0x...

# Oracle agent private key (only for ResolveScript)
ORACLE_PRIVATE_KEY=0x...

# Protocol fee treasury (multisig recommended)
TREASURY_ADDRESS=0x...

# Initial seed liquidity per market in USDC (6 decimals)
# Default: 100 USDC = 100000000
SEED_USDC=100000000

# ── For ResolveScript ────────────────────────────────
# Market to resolve
MARKET_ADDRESS=0x...

# Outcome: 1=YES 2=NO 3=INVALID
OUTCOME=1
